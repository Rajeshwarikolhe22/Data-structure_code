#include<iostream>
using namespace std;
int main()
{
    int n;
    cout<<"enter number of student";
    cin>>n;
    int*arr=(int*)malloc(n*sizeof(int));
    if(arr==NULL)
    {
        cout<<"Overflow";
        return 0;
    }
    cout<<"enter"<<n<<"marks";
    int sum=0;
    for(int i=0;i<n;i++)
        {
            cin>>arr[1];
            sum=sum+arr[i];
        }
    cout<<"total"<<sum;
    free(arr);
    return 0;
}
